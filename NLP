        "\n",
        "from sklearn.feature_extraction.text import CountVectorizer\n",
        "from sklearn.decomposition import LatentDirichletAllocation\n",
        "\n",
        "documents = [\n",
        "    \"Machine learning and artificial intelligence are growing fields.\",\n",
        "    \"Deep learning uses neural networks for image recognition.\",\n",
        "    \"Python and Java are popular programming languages.\",\n",
        "    \"Software development involves coding and testing applications.\",\n",
        "    \"Artificial intelligence uses machine learning algorithms.\",\n",
        "    \"Programming languages help developers build software.\",\n",
        "    \"Neural networks are widely used in deep learning.\",\n",
        "    \"Python is useful for artificial intelligence projects.\"\n",
        "]\n",
        "\n",
        "vectorizer = CountVectorizer(\n",
        "    stop_words=\"english\"\n",
        ")\n",
        "\n",
        "document_vectors = vectorizer.fit_transform(documents)\n",
        "\n",
        "lda_model = LatentDirichletAllocation(\n",
        "    n_components=2,\n",
        "    random_state=42,\n",
        "    max_iter=10\n",
        ")\n",
        "\n",
        "lda_model.fit(document_vectors)\n",
        "\n",
        "words = vectorizer.get_feature_names_out()\n",
        "\n",
        "print(\"TOPIC MODELLING USING LDA\")\n",
        "print(\"-\" * 50)\n",
        "\n",
        "for topic_index, topic in enumerate(lda_model.components_):\n",
        "    top_indices = topic.argsort()[-5:][::-1]\n",
        "    top_words = [words[i] for i in top_indices]\n",
        "\n",
        "    print(f\"\\nTopic {topic_index + 1}:\")\n",
        "    print(\", \".join(top_words))\n"
      ],
