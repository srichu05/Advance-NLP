        "\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "\n",
        "documents = [\n",
        "    \"Artificial Intelligence enables machines to perform tasks that require human intelligence.\",\n",
        "    \"Machine learning is a branch of AI that learns patterns from data.\",\n",
        "    \"Natural Language Processing helps computers understand human language.\",\n",
        "    \"Deep learning uses neural networks with multiple layers.\",\n",
        "    \"Python is a popular programming language used for machine learning.\"\n",
        "]\n",
        "\n",
        "vectorizer = TfidfVectorizer()\n",
        "document_vectors = vectorizer.fit_transform(documents)\n",
        "\n",
        "question = input(\"Enter your question: \")\n",
        "\n",
        "question_vector = vectorizer.transform([question])\n",
        "similarities = cosine_similarity(\n",
        "    question_vector, document_vectors\n",
        ")[0]\n",
        "\n",
        "best_index = similarities.argmax()\n",
        "\n",
        "print(\"\\nQuestion:\", question)\n",
        "print(\"Most Relevant Answer:\", documents[best_index])\n",
        "print(\"Similarity Score:\", round(similarities[best_index], 4))\n"
      ],
