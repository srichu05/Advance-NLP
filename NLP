        "\n",
        "import spacy\n",
        "\n",
        "nlp = spacy.load(\"en_core_web_sm\")\n",
        "\n",
        "text = \"\"\"\n",
        "Apple was founded by Steve Jobs in California in 1976.\n",
        "Google is a technology company located in the United States.\n",
        "\"\"\"\n",
        "\n",
        "doc = nlp(text)\n",
        "\n",
        "print(\"POS TAGGING\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "for token in doc:\n",
        "    if not token.is_space:\n",
        "        print(f\"{token.text:15} {token.pos_:10} {token.tag_}\")\n",
        "\n",
        "print(\"\\nNAMED ENTITY RECOGNITION\")\n",
        "print(\"-\" * 60)\n",
        "\n",
        "for entity in doc.ents:\n",
        "    print(f\"{entity.text:25} {entity.label_}\")\n"
      ],
